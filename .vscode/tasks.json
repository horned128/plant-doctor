{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Toolchain: Setup",
      "type": "process",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/firmware/ml63q2557/scripts/setup-toolchain.ps1"
      ],
      "osx": {
        "command": "/bin/bash",
        "args": [
          "${workspaceFolder}/firmware/ml63q2557/scripts/setup-toolchain.sh",
          "--build-only"
        ]
      },
      "problemMatcher": []
    },
    {
      "label": "Build: Debug",
      "type": "process",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/firmware/ml63q2557/scripts/build.ps1",
        "-Preset",
        "debug"
      ],
      "osx": {
        "command": "/bin/bash",
        "args": [
          "${workspaceFolder}/firmware/ml63q2557/scripts/build.sh",
          "--preset",
          "debug"
        ]
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "Build: Release",
      "type": "process",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/firmware/ml63q2557/scripts/build.ps1",
        "-Preset",
        "release"
      ],
      "osx": {
        "command": "/bin/bash",
        "args": [
          "${workspaceFolder}/firmware/ml63q2557/scripts/build.sh",
          "--preset",
          "release"
        ]
      },
      "group": "build",
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "Flash: Debug (MCU-Link)",
      "type": "process",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/firmware/ml63q2557/scripts/flash.ps1",
        "-Preset",
        "debug"
      ],
      "osx": {
        "command": "/bin/bash",
        "args": [
          "${workspaceFolder}/firmware/ml63q2557/scripts/flash.sh",
          "--preset",
          "debug"
        ]
      },
      "dependsOn": "Build: Debug",
      "problemMatcher": []
    }
  ]
}
