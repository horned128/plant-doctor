{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build: Debug",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/firmware/ml63q2557/scripts/build.ps1",
        "-Preset",
        "debug"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "Build: Release",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/firmware/ml63q2557/scripts/build.ps1",
        "-Preset",
        "release"
      ],
      "group": "build",
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "Flash: Debug (MCU-Link)",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/firmware/ml63q2557/scripts/flash.ps1",
        "-Preset",
        "debug"
      ],
      "dependsOn": "Build: Debug",
      "problemMatcher": []
    },
    {
      "label": "Flash: Sensor Diagnostic (MCU-Link)",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/firmware/ml63q2557/scripts/flash.ps1",
        "-Preset",
        "debug",
        "-Target",
        "SensorDiagnostic"
      ],
      "dependsOn": "Build: Debug",
      "problemMatcher": []
    }
  ]
}
